# Parsed as data, never sourced. Empty password => generated by `lab config init`.
LAB_USER=labuser
LAB_PASSWORD=
LAB_LOCALE=it_IT.UTF-8
LAB_KEYBOARD=it
LAB_TIMEZONE=Europe/Rome
LAB_HOSTNAME=playground
LAB_DISK_GB=64
LAB_RAM_MB=4096
LAB_CPUS=2
# Windows uses the next port.
LAB_SSH_PORT=2400
# Menu language only (en or it). Code, logs and reports are always English.
LAB_LANG=en
# Graphical console on 127.0.0.1 (Windows takes the next port); 0 disables it.
# 5940 stays clear of libvirt, which hands out 5900 upwards. Exposing it is
# recorded; if a client actually connects during an installation, the report says
# the run is no longer provably unattended.
LAB_VNC_PORT=5940
# Sound card, off by default. A QEMU audio backend name (pipewire, pa, alsa...)
# routes guest audio to the host's daemon; a headless host has none, and naming a
# backend that is not there stops QEMU from starting. The graphical console always
# gets a USB tablet, so the pointer tracks instead of drifting.
LAB_AUDIO=none
LAB_ACCEL=kvm
LAB_INSTALL_TIMEOUT=7200
LAB_SHOT_INTERVAL=20
LAB_WINDOWS_IMAGE=Windows 11 Pro
LAB_WINDOWS_LANGUAGE=it-IT
LAB_WINDOWS_TIMEZONE=W. Europe Standard Time
LAB_OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.ms.fd
LAB_OVMF_VARS=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
# Obtain the signed x64 QEMU guest agent MSI separately; see docs/WINDOWS.md.
LAB_QGA_MSI=
LAB_QGA_SHA256=
LAB_QGA_SOURCE=
